% Atividade filtragem digital de sinais
% clear all;
close all;
% clc;

addpath(genpath("atividades_praticas"));   % torna broadband1.mat visível

load('S03.mat'); % Carrega os filtros projetados
load('lowpass.mat'); % Carrega os filtros projetados

[Nsamples, Nchannels,trials] = size(stimuliData); % Obtém o número de amostras e canais do sinal
t = 0:(1/fs):(Nsamples-1)*(1/fs);  % Vetor de tempo
sinal = stimuliData(:, 5, 3) % POz, Trial 3, estimulo 10Hz

figure(1);
plot(t, sinal)
xlabel('Tempo (s)');
ylabel('Amplitude');
title('Sinal original no canal POz - Trial 3');
grid on;
 
[pxx, fw] = pwelch(sinal, 1536, fs);

figure(2);
plot(fw, pxx, 'k');
xlim([1.5 2.5]);
xlabel('Frequência (Hz)');
ylabel('PSD');
title('Densidade espectral de potência do sinal bruto');
grid on;

% Aplicar o filtro projetado ao sinal
sinalFiltrado = filtfilt(SOS, G, sinal);

[pxxf, fwf] = pwelch(sinalFiltrado, 1536, fs);

figure(3);
plot(fwf, pxxf, 'k');
xlim([0 2.5]);
xlabel('Frequência (Hz)');
ylabel('PSD');
title('Densidade espectral de potência do sinal filtrado');
grid on;

% 
figure(4);
plot(t, sinalFiltrado)
xlabel('Tempo (s)');
ylabel('Amplitude');
title('Sinal filtrado no canal POz - Trial 3');
grid on;